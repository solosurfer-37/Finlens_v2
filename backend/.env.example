# FinLens backend - environment variable template.
# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Application ---
DEBUG=False

# --- Database (REQUIRED) ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/finlens

# --- AI (REQUIRED) ---
GEMINI_API_KEY=CHANGE_ME

# --- Security (REQUIRED) ---
# Generate with: py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- File uploads ---
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=100

# --- CORS (JSON list) ---
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5500"]